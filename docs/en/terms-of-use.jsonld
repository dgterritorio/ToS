  "description": "Terms of use for the public OGC APIs of the Directorate-General for Territory.",
  "additionalProperty": [
    {
      "@type": "schema:PropertyValue",
      "name": "Scope",
      "value": "These terms establish the general conditions for using the public OGC APIs provided by the Directorate-General for Territory (DGT)."
    },
    {
      "@type": "schema:PropertyValue",
      "name": "Responsible use",
      "value": "Users should avoid behaviour that could degrade the service or impair access by other users."
    },
    {
      "@type": "schema:PropertyValue",
      "name": "Data licence",
      "value": "The applicable licence should be consulted in the metadata of the respective collection."
    },
    {
      "@type": "schema:PropertyValue",
      "name": "Maintenance and availability",
      "value": "Services may be temporarily unavailable for maintenance, updates, corrections or technological evolution."
    },
    {
      "@type": "schema:PropertyValue",
      "name": "Limitation",
      "value": "Users should assess the suitability of the data and service for their intended purpose. The use of data in third-party systems or applications is the responsibility of their respective users."
    },
    {
      "@type": "schema:PropertyValue",
      "name": "Requirements for automated use",
      "value": [
        "use pagination",
        "apply filters where available",
        "limit concurrent requests",
        "avoid unnecessary repeated requests",
        "reuse results where appropriate",
        "avoid unnecessarily large queries",
        "implement appropriate handling of errors and temporary service unavailability"
      ]
    }
  ],
  "subjectOf": {
    "@type": "DigitalDocument",
